HF_API_KEY=your-huggingface-api-key
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

RAG_CHUNK_SIZE=750
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.62
MAX_UPLOAD_MB=20
